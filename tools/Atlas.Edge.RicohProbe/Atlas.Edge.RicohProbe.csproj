<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(EnableRicohSdk)' != 'true'">net8.0</TargetFramework>
    <TargetFramework Condition="'$(EnableRicohSdk)' == 'true'">net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableRicohSdk Condition="'$(EnableRicohSdk)' == ''">false</EnableRicohSdk>
    <RicohProbeArchitecture Condition="'$(EnableRicohSdk)' == 'true' and '$(RicohProbeArchitecture)' == ''">x64</RicohProbeArchitecture>
    <DefineConstants Condition="'$(EnableRicohSdk)' == 'true'">$(DefineConstants);RICOH_SDK</DefineConstants>
    <UseWindowsForms Condition="'$(EnableRicohSdk)' == 'true'">true</UseWindowsForms>
    <EnableWindowsTargeting Condition="'$(EnableRicohSdk)' == 'true'">true</EnableWindowsTargeting>
    <PlatformTarget Condition="'$(EnableRicohSdk)' == 'true'">$(RicohProbeArchitecture)</PlatformTarget>
    <RuntimeIdentifier Condition="'$(EnableRicohSdk)' == 'true'">win-$(RicohProbeArchitecture)</RuntimeIdentifier>
    <Prefer32Bit Condition="'$(EnableRicohSdk)' == 'true'">false</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableRicohSdk)' == 'true'">
    <RicohSampleStatePath>$(RicohSdkRoot)\Sample\ScanTest\VCS 2017\FormScan.resx</RicohSampleStatePath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableRicohSdk)' == 'true' and '$(RicohProbeArchitecture)' == 'x64'">
    <RicohSdkInteropDirectory>$(RicohSdkRoot)\Sample\ScanTest\VCS 2017\x64\bin\Release</RicohSdkInteropDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableRicohSdk)' == 'true' and '$(RicohProbeArchitecture)' == 'x86'">
    <RicohSdkInteropDirectory>$(RicohSdkRoot)\Sample\ScanTest\VCS 2017\bin\Release</RicohSdkInteropDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableRicohSdk)' == 'true'">
    <RicohAxInteropPath>$(RicohSdkInteropDirectory)\AxInterop.FiScnLib.dll</RicohAxInteropPath>
    <RicohInteropPath>$(RicohSdkInteropDirectory)\Interop.FiScnLib.dll</RicohInteropPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableRicohSdk)' == 'true'">
    <Reference Include="AxInterop.FiScnLib">
      <HintPath>$(RicohAxInteropPath)</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Interop.FiScnLib">
      <HintPath>$(RicohInteropPath)</HintPath>
      <Private>true</Private>
    </Reference>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RicohSdkRoot</_Parameter1>
      <_Parameter2>$(RicohSdkRoot)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Condition="'$(EnableRicohSdk)' != 'true'">
    <Compile Remove="WindowsRicohScannerControlHost.Sdk.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Atlas.Edge.ScannerDiscovery\Atlas.Edge.ScannerDiscovery.csproj" />
  </ItemGroup>

  <Target Name="ValidateRicohSdkReferences" BeforeTargets="ResolveReferences" Condition="'$(EnableRicohSdk)' == 'true'">
    <Error Condition="'$(RicohSdkRoot)' == ''" Text="RicohSdkRoot is required when EnableRicohSdk=true." />
    <Error Condition="'$(RicohProbeArchitecture)' != 'x64' and '$(RicohProbeArchitecture)' != 'x86'" Text="RicohProbeArchitecture must be explicitly set to x64 or x86." />
    <Error Condition="!Exists('$(RicohAxInteropPath)')" Text="The $(RicohProbeArchitecture) AxInterop.FiScnLib.dll reference was not found beneath RicohSdkRoot at '$(RicohAxInteropPath)'." />
    <Error Condition="!Exists('$(RicohInteropPath)')" Text="The $(RicohProbeArchitecture) Interop.FiScnLib.dll reference was not found beneath RicohSdkRoot at '$(RicohInteropPath)'." />
    <Error Condition="!Exists('$(RicohSampleStatePath)')" Text="The official FormScan.resx ActiveX state was not found beneath RicohSdkRoot." />
  </Target>
</Project>
