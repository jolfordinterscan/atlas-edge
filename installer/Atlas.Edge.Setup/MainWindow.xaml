<Window x:Class="Atlas.Edge.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Atlas.Edge.Setup.Views"
        Title="Atlas Edge Setup"
        Width="980"
        Height="650"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB">

    <Window.Resources>
        <SolidColorBrush x:Key="AtlasNavy" Color="#0E1F41" />
        <SolidColorBrush x:Key="AtlasBlue" Color="#2563EB" />
        <SolidColorBrush x:Key="AtlasText" Color="#182033" />
        <SolidColorBrush x:Key="AtlasMuted" Color="#667085" />

        <Style TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="285" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource AtlasNavy}">
            <Grid Margin="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="INTERSCAN"
                               Foreground="#90B7FF"
                               FontSize="12"
                               FontWeight="Bold" />

                    <TextBlock Text="Atlas Edge"
                               Margin="0,8,0,4"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="SemiBold" />

                    <TextBlock Text="Enterprise Scanner Intelligence"
                               Foreground="#B9C5DB"
                               FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Margin="0,70,0,0">

                    <TextBlock x:Name="WelcomeStep"
                               Text="●  Welcome"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,0,0,22" />

                    <TextBlock x:Name="ConnectStep"
                               Text="○  Connect to Atlas"
                               Foreground="#92A2BE"
                               FontSize="15"
                               Margin="0,0,0,22" />

                    <TextBlock x:Name="InstallStep"
                               Text="○  Install"
                               Foreground="#92A2BE"
                               FontSize="15"
                               Margin="0,0,0,22" />

                    <TextBlock x:Name="VerifyStep"
                               Text="○  Verify"
                               Foreground="#92A2BE"
                               FontSize="15"
                               Margin="0,0,0,22" />

                    <TextBlock x:Name="CompleteStep"
                               Text="○  Complete"
                               Foreground="#92A2BE"
                               FontSize="15" />
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Text="Atlas Edge Setup v0.7"
                           Foreground="#8190AA"
                           FontSize="11" />
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              Margin="64,50,64,38">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <views:WelcomeView x:Name="WelcomePanel" />

                <StackPanel x:Name="ConnectPanel"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"
                            MaxWidth="570">

                    <TextBlock Text="Connect to Atlas"
                               Foreground="{StaticResource AtlasText}"
                               FontSize="34"
                               FontWeight="SemiBold" />

                    <TextBlock Margin="0,18,0,28"
                               Text="Enter the Atlas enrollment details for this computer."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource AtlasMuted}"
                               FontSize="16" />

                    <TextBlock Text="Atlas server"
                               Foreground="{StaticResource AtlasMuted}"
                               FontSize="13" />

                    <TextBox x:Name="AtlasServerTextBox"
                             Margin="0,8,0,20"
                             Height="40"
                             Padding="10,8"
                             Text="https://atlas-web-staging-732a.up.railway.app/" />

                    <TextBlock Text="Enrollment code"
                               Foreground="{StaticResource AtlasMuted}"
                               FontSize="13" />

                    <PasswordBox x:Name="EnrollmentCodeBox"
                                 Margin="0,8,0,20"
                                 Height="40"
                                 Padding="10,8" />

                    <Border Background="White"
                            BorderBrush="#E2E7F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18">
                        <StackPanel>
                            <TextBlock Text="Computer"
                                       Foreground="{StaticResource AtlasMuted}"
                                       FontSize="12" />

                            <TextBlock x:Name="ConnectComputerNameText"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource AtlasText}"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="InstallPanel"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"
                            MaxWidth="570">

                    <TextBlock Text="Install Atlas Edge"
                               Foreground="{StaticResource AtlasText}"
                               FontSize="34"
                               FontWeight="SemiBold" />

                    <TextBlock Margin="0,18,0,28"
                               Text="Atlas Edge will install the runtime, register the Windows service, and prepare this computer for Atlas."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource AtlasMuted}"
                               FontSize="16" />

                    <ProgressBar x:Name="InstallProgressBar"
                                 Height="12"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Margin="0,0,0,28" />

                    <Border Background="White"
                            BorderBrush="#E2E7F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="22">

                        <StackPanel>
                            <TextBlock x:Name="RuntimeInstallStatus"
                                       Text="○ Runtime files"
                                       Margin="0,0,0,16"
                                       FontSize="14" />

                            <TextBlock x:Name="ServiceInstallStatus"
                                       Text="○ Windows service"
                                       Margin="0,0,0,16"
                                       FontSize="14" />

                            <TextBlock x:Name="ConfigurationInstallStatus"
                                       Text="○ Enrollment configuration"
                                       Margin="0,0,0,16"
                                       FontSize="14" />

                            <TextBlock x:Name="StartupInstallStatus"
                                       Text="○ Starting Atlas Edge"
                                       FontSize="14" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="InstallDetailText"
                               Margin="0,18,0,0"
                               Text="Ready to install."
                               Foreground="{StaticResource AtlasMuted}"
                               FontSize="13"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="VerifyPanel"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"
                            MaxWidth="570">

                    <TextBlock Text="Verify Atlas Edge"
                               Foreground="{StaticResource AtlasText}"
                               FontSize="34"
                               FontWeight="SemiBold" />

                    <TextBlock Margin="0,18,0,28"
                               Text="We will verify the Windows service, protected credentials, and secure enrollment handoff."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource AtlasMuted}"
                               FontSize="16" />

                    <Border Background="White"
                            BorderBrush="#E2E7F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="20">

                        <StackPanel>
                            <TextBlock x:Name="VerifyServiceStatus"
                                       Text="○ Windows service"
                                       Margin="0,0,0,14"
                                       FontSize="14" />

                            <TextBlock x:Name="VerifyCredentialsStatus"
                                       Text="○ Protected credentials"
                                       Margin="0,0,0,14"
                                       FontSize="14" />

                            <TextBlock x:Name="VerifyTokenStatus"
                                       Text="○ Enrollment token removed"
                                       Margin="0,0,0,14"
                                       FontSize="14" />

                            <TextBlock x:Name="VerifyOverallStatus"
                                       Text="○ Atlas Edge readiness"
                                       FontSize="14" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="VerifyDetailText"
                               Margin="0,18,0,0"
                               Text="Ready to verify."
                               Foreground="{StaticResource AtlasMuted}"
                               FontSize="13"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="CompletePanel"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"
                            MaxWidth="570">

                    <Border Width="66"
                            Height="66"
                            HorizontalAlignment="Left"
                            CornerRadius="33"
                            Background="#E8F7EE"
                            Margin="0,0,0,28">
                        <TextBlock Text="✓"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#159455"
                                   FontSize="30"
                                   FontWeight="Bold" />
                    </Border>

                    <TextBlock Text="Atlas Edge is ready"
                               Foreground="{StaticResource AtlasText}"
                               FontSize="34"
                               FontWeight="SemiBold" />

                    <TextBlock Margin="0,18,0,0"
                               Text="This computer has completed local Atlas Edge verification."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource AtlasMuted}"
                               FontSize="16" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton"
                        Content="Back"
                        Click="Back_Click"
                        IsEnabled="False"
                        Background="Transparent"
                        BorderBrush="#CBD2DF"
                        Foreground="#7A8498" />

                <Button x:Name="NextButton"
                        Grid.Column="1"
                        Content="Get Started"
                        Click="Next_Click"
                        Background="{StaticResource AtlasBlue}"
                        BorderBrush="{StaticResource AtlasBlue}"
                        Foreground="White" />
            </Grid>
        </Grid>
    </Grid>
</Window>